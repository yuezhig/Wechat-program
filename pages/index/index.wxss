.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.header {
  text-align: center;
  margin-bottom: 40rpx;
}

.title {
  font-size: 48rpx;
  font-weight: bold;
  display: block;
}

.subtitle {
  font-size: 28rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}

.question-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 40rpx;
  margin-bottom: 30rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.label {
  font-size: 24rpx;
  color: #1890ff;
  display: block;
  margin-bottom: 20rpx;
}

.preview-img {
  width: 100%;
  max-height: 400rpx;
  border-radius: 8rpx;
  margin-bottom: 20rpx;
}

.preview-text {
  font-size: 28rpx;
  color: #333;
  display: block;
  margin-bottom: 20rpx;
  line-height: 1.6;
}

.preview-explain {
  font-size: 26rpx;
  color: #666;
  background: #f9f9f9;
  padding: 20rpx;
  border-radius: 8rpx;
  margin-top: 20rpx;
}

.explain-label {
  font-weight: bold;
  color: #1890ff;
}

.explain-img-box {
  margin-top: 20rpx;
}

.question-hint {
  font-size: 24rpx;
  color: #999;
}

.empty-tip {
  text-align: center;
  padding: 40rpx 0;
}

.empty-tip text {
  display: block;
  color: #999;
}

.hint {
  font-size: 24rpx;
  color: #ccc !important;
  margin-top: 10rpx;
}

.stats {
  display: flex;
  justify-content: space-around;
  margin-bottom: 30rpx;
}

.stat-item {
  background: #fff;
  border-radius: 16rpx;
  padding: 30rpx 60rpx;
  text-align: center;
}

.stat-num {
  font-size: 40rpx;
  font-weight: bold;
  color: #1890ff;
  display: block;
}

.stat-label {
  font-size: 24rpx;
  color: #666;
  margin-top: 10rpx;
  display: block;
}

.menu {
  background: #fff;
  border-radius: 16rpx;
}

.menu-item {
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
  font-size: 30rpx;
}

.menu-item:last-child {
  border-bottom: none;
}