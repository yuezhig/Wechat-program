.loading-container {
  position: fixed;
  left: 0;
  top: 0;
  width: 100%;
  height: 100%;
  background-color: #06ced3;
  display: flex;
  flex-direction: column;
  align-items: center;
  justify-content: center;
  z-index: 9999;
}

.loadingBox {
  position: absolute;
  left: 50%;
  top: 50%;
  width: 40px;
  height: 40px;
  margin: -30px 0 0 -20px;
  font-size: 30px;
  color: rgba(255, 255, 255, 1);
  padding: 1em;
  vertical-align: top;
}

.loader {
  background: currentcolor;
  position: absolute;
  animation: loader 1s ease-in-out infinite;
  animation-delay: 0.4s;
  width: 0.25em;
  height: 0.5em;
}

.loader:after,
.loader:before {
  content: '';
  position: absolute;
  width: inherit;
  height: inherit;
  background: inherit;
  animation: inherit;
}

.loader:before {
  right: 0.5em;
  animation-delay: 0.2s;
}

.loader:after {
  left: 0.5em;
  animation-delay: 0.6s;
}

@keyframes loader {
  0%, 100% {
    box-shadow: 0 0 0 currentcolor, 0 0 0 currentcolor;
  }
  50% {
    box-shadow: -0.25em 0 0 currentcolor, 0.25em 0 0 currentcolor;
  }
}

.title {
  color: #fff;
  font-size: 48rpx;
  font-weight: 700;
  margin-bottom: 20rpx;
}

.subtitle {
  color: rgba(255, 255, 255, 0.8);
  font-size: 28rpx;
}