<view class="container">
  <view class="header">
    <text class="title">酷我帅帅哥的错题本</text>
    <text class="subtitle">{{date}}</text>
  </view>
  
  <view class="question-card">
    <text class="label">今日复习</text>
    <view wx:if="{{todayWrong}}">
      <view wx:if="{{todayWrong.qType === 'camera'}}">
        <image wx:if="{{todayWrong.questionImage}}" src="{{todayWrong.questionImage}}" mode="aspectFit" class="preview-img" catchtap="previewImage" data-src="{{todayWrong.questionImage}}"/>
      </view>
      <view wx:if="{{todayWrong.qType === 'text'}}">
        <text class="preview-text">{{todayWrong.questionText}}</text>
      </view>
      <view wx:if="{{todayWrong.eType === 'text' && todayWrong.explainText}}" class="preview-explain">
        <text class="explain-label">解析：</text>{{todayWrong.explainText}}
      </view>
      <view wx:if="{{todayWrong.eType === 'camera' && todayWrong.explainImage}}" class="explain-img-box">
        <text class="explain-label">解析：</text>
        <image src="{{todayWrong.explainImage}}" mode="aspectFit" class="preview-img" catchtap="previewImage" data-src="{{todayWrong.explainImage}}"/>
      </view>
    </view>
    <view wx:else class="empty-tip">
      <text>暂无错题</text>
      <text class="hint">点击下方添加错题</text>
    </view>
  </view>

  <view class="stats">
    <view class="stat-item">
      <text class="stat-num">{{totalCount}}</text>
      <text class="stat-label">错题总数</text>
    </view>
  </view>

  <view class="menu">
    <view class="menu-item" bindtap="goToAddWrong">+ 添加错题</view>
    <view class="menu-item" bindtap="goToWrongBook">查看全部错题</view>
  </view>
</view>