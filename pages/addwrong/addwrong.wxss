.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.form {
  background: #fff;
  border-radius: 12rpx;
  padding: 30rpx;
}

.form-section {
  margin-bottom: 50rpx;
}

.section-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 20rpx;
}

.section-title {
  font-size: 30rpx;
  font-weight: bold;
  color: #333;
}

.type-switch text {
  font-size: 24rpx;
  padding: 10rpx 20rpx;
  color: #999;
}

.type-switch text.active {
  color: #1890ff;
  font-weight: bold;
}

.upload-box {
  width: 200rpx;
  height: 200rpx;
  border: 2rpx dashed #ccc;
  border-radius: 12rpx;
  display: flex;
  align-items: center;
  justify-content: center;
}

.upload-icon {
  font-size: 60rpx;
  color: #ccc;
}

.preview-img {
  width: 200rpx;
  height: 200rpx;
}

.input {
  width: 100%;
  height: 200rpx;
  padding: 20rpx;
  border: 2rpx solid #e0e0e0;
  border-radius: 8rpx;
  font-size: 28rpx;
  box-sizing: border-box;
}

.btn-submit {
  background: #1890ff;
  color: #fff;
  padding: 26rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
  margin-top: 40rpx;
}