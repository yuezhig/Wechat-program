<view class="container" wx:if="{{leave}}">
  <view class="card summary-card">
    <view class="summary-top">
      <view class="summary-left">
        <view class="leave-type">{{leave.type}}</view>
        <view class="my-apply">我的 请假申请</view>
      </view>
      <view class="status-stamp" wx:if="{{leave.status !== '已完成' && leave.status !== '已通过'}}">{{leave.status}}</view>
    </view>

    <view class="info-container">
    <view class="summary-row double-row">
      <view class="summary-field">
        <text class="summary-label" style="color:#B7B8BA">请假类型：</text>
        <text>{{leave.type}}</text>
      </view>
      <view class="summary-field" style="margin-left:60rpx;">
        <text class="summary-label" space="nbsp" style="color:#B7B8BA">          需要离校：</text>
        <text>{{leave.leaveCampus ? '是' : '否'}}</text>
      </view>
    </view>

    <view class="summary-row detail-rule">
      <text class="summary-label" style="color:#B7B8BA">销假规则：</text>
      <text>离校请假需要销假，非离校无需销假</text>
    </view>

    <view class="summary-row detail-time">
      <text class="summary-label" style="color:#B7B8BA">实际休假时间：</text>
      <text>-</text>
    </view>
    </view>

    <view class="summary-row detail-line">
      <text class="summary-label" style="color:#B7B8BA">开始时间：</text>
      <text>{{leave.startTime}}</text>
    </view>
    <view class="summary-row detail-line">
      <text class="summary-label" style="color:#B7B8BA">结束时间：</text>
      <text>{{leave.endTime}}</text>
    </view>
    <view class="summary-row approval-flow">
      <text class="summary-label" style="color:#B7B8BA">审批流程：</text>
      <text>共{{leave.approvals.length}}步</text>
      <text class="view-more">查看 ></text>
    </view>

    <view class="reason-block">
      <text class="reason-label" style="color:#B7B8BA">请假原因：</text>
      <view class="details-content">{{leave.reason}}</view>
    </view>

    <view class="summary-row detail-line">
      <text class="summary-label" style="color:#B7B8BA">发起位置：</text>
      <text>{{leave.applyLocation}}</text>
    </view>
    <view class="summary-row detail-line">
      <text class="summary-label" style="color:#B7B8BA">宿舍信息：</text>
      <text>{{leave.dormInfo}}</text>
    </view>

    <view class="promise-box">
      <view class="promise-icon"></view>
      <view class="promise-text">本人承诺填写的信息真实有效，并对本次提交请假申请的信息真实性负责。</view>
    </view>
  </view>

  <view class="card flow-card">
    <view class="section-title">审批流程记录</view>
    <view class="approval-steps">
      <view class="timeline-line"></view>
      <block wx:for="{{leave.approvals}}" wx:key="index">
        <view class="step">
          <view class="step-marker"></view>
          <view class="step-body">
            <view class="step-name">{{item.name}} - {{item.action}}</view>
            <view class="step-time">{{item.time}}</view>
            <view class="step-opinion" wx:if="{{item.opinion}}">{{item.opinion}}</view>
          </view>
        </view>
      </block>
    </view>
    <view class="current-approver">当前审批人：{{leave.teacher}}</view>
    <button class="forward-btn" bindtap="forwardLeave">转发</button>
  </view>
</view>

<view class="no-data" wx:else>暂无请假详情</view>