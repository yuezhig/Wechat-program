<view class="container">
  <view class="tab">
    <view class="tab-item {{tab === 'all' ? 'active' : ''}}" bindtap="switchTab" data-tab="all">
      <text>全部</text>
    </view>
    <view class="tab-item {{tab === 'done' ? 'active' : ''}}" bindtap="switchTab" data-tab="done">
      <text>已答</text>
    </view>
  </view>

  <view class="question-list">
    <view class="question-item" wx:for="{{questions}}" wx:key="id" bindtap="viewQuestion" data-id="{{item.id}}">
      <view class="question-info">
        <text class="question-date">{{item.date}}</text>
        <text class="question-title">{{item.title}}</text>
      </view>
      <view class="question-status {{item.done ? (item.correct ? 'correct' : 'wrong') : ''}}">
        <text>{{item.done ? (item.correct ? '正确' : '错误') : '未答'}}</text>
      </view>
    </view>
  </view>
</view>