.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
}

.tab {
  display: flex;
  background: #fff;
  border-radius: 12rpx;
  margin-bottom: 30rpx;
}

.tab-item {
  flex: 1;
  text-align: center;
  padding: 26rpx;
  font-size: 28rpx;
  color: #666;
}

.tab-item.active {
  color: #1890ff;
  border-bottom: 4rpx solid #1890ff;
}

.question-list {
  background: #fff;
  border-radius: 12rpx;
}

.question-item {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 30rpx;
  border-bottom: 1rpx solid #f0f0f0;
}

.question-item:last-child {
  border-bottom: none;
}

.question-info {
  flex: 1;
}

.question-date {
  font-size: 24rpx;
  color: #999;
  display: block;
  margin-bottom: 10rpx;
}

.question-title {
  font-size: 28rpx;
  color: #333;
  display: block;
}

.question-status {
  font-size: 24rpx;
  padding: 8rpx 20rpx;
  border-radius: 20rpx;
  background: #f0f0f0;
  color: #666;
}

.question-status.correct {
  background: #f6ffed;
  color: #52c41a;
}

.question-status.wrong {
  background: #fff2f0;
  color: #ff4d4f;
}