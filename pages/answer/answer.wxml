<view class="container">
  <view class="header">
    <text>答题完成</text>
  </view>
  
  <view class="result-card">
    <view class="result-icon {{isCorrect ? 'correct' : 'wrong'}}">
      <text>{{isCorrect ? '✓' : '✗'}}</text>
    </view>
    <text class="result-text">{{isCorrect ? '回答正确' : '回答错误'}}</text>
  </view>

  <view class="btn-group">
    <view class="btn" bindtap="goHome">
      <text>返回首页</text>
    </view>
    <view class="btn btn-outline" bindtap="shareResult">
      <text>分享给好友</text>
    </view>
  </view>
</view>