.container {
  padding: 30rpx;
  background-color: #f5f5f5;
  min-height: 100vh;
  display: flex;
  flex-direction: column;
  align-items: center;
}

.header {
  font-size: 36rpx;
  font-weight: bold;
  margin: 40rpx 0;
}

.result-card {
  background: #fff;
  border-radius: 16rpx;
  padding: 60rpx 80rpx;
  text-align: center;
  margin: 40rpx 0;
}

.result-icon {
  font-size: 80rpx;
  margin-bottom: 20rpx;
}

.result-icon.correct {
  color: #52c41a;
}

.result-icon.wrong {
  color: #ff4d4f;
}

.result-text {
  font-size: 32rpx;
  color: #333;
}

.btn-group {
  width: 100%;
  padding: 0 30rpx;
}

.btn {
  background: #1890ff;
  color: #fff;
  padding: 26rpx;
  border-radius: 12rpx;
  text-align: center;
  font-size: 30rpx;
  margin-bottom: 20rpx;
}

.btn-outline {
  background: #fff;
  color: #1890ff;
  border: 2rpx solid #1890ff;
}