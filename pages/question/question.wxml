<view class="container">
  <view class="question-content">
    <text class="question-title">{{question.title}}</text>
    <view class="math-content">
      <text>{{question.content}}</text>
    </view>
  </view>

  <view class="options">
    <view 
      class="option {{selected === index ? 'selected' : ''}}"
      wx:for="{{question.options}}"
      wx:key="index"
      bindtap="selectAnswer"
      data-index="{{index}}">
      <text>{{item}}</text>
    </view>
  </view>

  <view class="btn-submit" bindtap="submitAnswer">
    <text>提交答案</text>
  </view>

  <view class="result" wx:if="{{showResult}}">
    <view class="result-header {{isCorrect ? 'correct' : 'wrong'}}">
      <text>{{isCorrect ? '回答正确 ✓' : '回答错误 ✗'}}</text>
    </view>
    <view class="explanation">
      <text class="exp-title">解析</text>
      <text class="exp-content">{{question.explanation}}</text>
    </view>
  </view>
</view>