<view class="container">
  <view class="header">
    <text class="title">错题本</text>
    <view class="header-right">
      <text class="count">共 {{wrongQuestions.length}} 题</text>
      <view class="add-btn" bindtap="goToAddWrong">
        <text>+ 添加错题</text>
      </view>
    </view>
  </view>

  <view class="empty" wx:if="{{wrongQuestions.length === 0}}">
    <text>暂无错题</text>
    <text class="empty-hint">点击右上角添加错题</text>
  </view>

  <view class="question-list">
    <view class="question-item" wx:for="{{wrongQuestions}}" wx:key="id">
      <view class="question-content">
        <view class="part">
          <text class="part-label">题目</text>
          <image wx:if="{{item.qType === 'camera' && item.questionImage}}" src="{{item.questionImage}}" mode="aspectFit" class="question-img" catchtap="previewImage" data-src="{{item.questionImage}}"/>
          <text wx:if="{{item.qType === 'text'}}" class="question-text">{{item.questionText}}</text>
        </view>
        <view class="part" wx:if="{{item.eType === 'text' ? item.explainText : item.explainImage}}">
          <text class="part-label">解析</text>
          <image wx:if="{{item.eType === 'camera' && item.explainImage}}" src="{{item.explainImage}}" mode="aspectFit" class="explain-img" catchtap="previewImage" data-src="{{item.explainImage}}"/>
          <text wx:if="{{item.eType === 'text'}}" class="explain-text">{{item.explainText}}</text>
        </view>
        <text class="question-date">{{item.addDate}}</text>
      </view>
      <view class="delete-btn" bindtap="deleteQuestion" data-id="{{item.id}}">删除</view>
    </view>
  </view>
</view>