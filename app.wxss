page {
  background-color: #f1f4f5;
  font-size: 28rpx;
  color: #323233;
}

.container {
  padding: 20rpx;
}

.card {
  background: #fff;
  border-radius: 8rpx;
  padding: 30rpx;
  margin-bottom: 20rpx;
  box-shadow: 0 2rpx 10rpx rgba(0,0,0,0.05);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f7;
}

.form-row {
  display: flex;
  border-bottom: 1rpx solid #eef1f7;
}

.form-item .label {
  width: 200rpx;
  color: #747d96;
  font-size: 28rpx;
}

.picker-value, input, textarea {
  flex: 1;
  color: #323233;
  font-size: 28rpx;
}

input::placeholder, textarea::placeholder {
  color: #acacbd !important;
}

textarea {
  min-height: 120rpx;
}

.submit-btn {
  background: linear-gradient(90deg, #1278f5, #3e92f7);
  color: #fff;
  border-radius: 50rpx;
  margin: 40rpx 20rpx;
  padding: 20rpx 0;
  font-size: 32rpx;
  border: none;
  height: 88rpx;
}

.submit-btn[disabled] {
  background: #dbe1ea;
  color: #bcc1cb;
}

.info-row {
  padding: 16rpx 0;
  display: flex;
}

.info-row .label {
  color: #747d96;
  width: 200rpx;
}

.reason {
  flex-direction: column;
}

.reason .label {
  width: 100%;
  margin-bottom: 10rpx;
}

.attachment-thumbs {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.attachment-thumbs image {
  width: 120rpx;
  height: 120rpx;
  border-radius: 8rpx;
}

.section-title {
  font-weight: 700;
  font-size: 32rpx;
  margin-bottom: 20rpx;
  color: #3e3e59;
  display: flex;
  align-items: center;
}

.section-title::before {
  content: "";
  display: inline-block;
  width: 8rpx;
  height: 36rpx;
  background: #28c58d;
  border-radius: 4rpx;
  margin-right: 16rpx;
}

.title-color {
  color: #3e3e59;
}

.title-part-color {
  color: #979eb1;
}

.other-color {
  color: #bcc1cb;
}

.emp-color {
  color: #28c58d;
}

.tips-color {
  color: #e47d38;
}

.bg-list-color {
  background: #f8f9fa;
}

.approval-steps .step {
  padding: 16rpx 0;
  border-left: 2rpx solid #28c58d;
  margin-left: 20rpx;
  padding-left: 30rpx;
  position: relative;
}

.approval-steps .step::before {
  content: '';
  position: absolute;
  left: -10rpx;
  top: 24rpx;
  width: 16rpx;
  height: 16rpx;
  background: #28c58d;
  border-radius: 50%;
}

.step-name {
  color: #323233;
  font-weight: 500;
}

.step-time {
  color: #747d96;
  font-size: 24rpx;
  margin-top: 8rpx;
}

.step-opinion {
  color: #747d96;
  font-size: 24rpx;
  margin-top: 8rpx;
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  background: #f8f9fa;
}

.current-approver {
  margin-top: 20rpx;
  color: #28c58d;
  font-size: 26rpx;
  padding: 16rpx;
  background: #eefbf7;
  border-radius: 8rpx;
  border: 1rpx solid #c0f1df;
  text-align: center;
}

.btn-group {
  display: flex;
  gap: 20rpx;
  margin-top: 20rpx;
}

.btn {
  flex: 1;
  padding: 20rpx 0;
  border-radius: 50rpx;
  font-size: 28rpx;
  text-align: center;
}

.btn-primary {
  background: #28c58d;
  color: #fff;
}

.btn-default {
  background: #f7f9fb;
  border: 1rpx solid #dbe1ea;
  color: #747d96;
}

.empty {
  text-align: center;
  color: #bcc1cb;
  padding: 100rpx 0;
  font-size: 28rpx;
}

.status-pass {
  background: #38d39d;
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 10rpx 10rpx 0 10rpx;
  font-size: 24rpx;
}

.status-pending {
  background: #38d39d;
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 10rpx 10rpx 0 10rpx;
  font-size: 24rpx;
}

.status-reject {
  background: #ff8946;
  color: #fff;
  padding: 8rpx 24rpx;
  border-radius: 10rpx 10rpx 0 10rpx;
  font-size: 24rpx;
}

switch .wx-switch-input {
  background-color: #28c58d !important;
  border-color: #3dd9a2 !important;
}

checkbox .wx-checkbox-input {
  border-color: #dbe1ea !important;
}

checkbox .wx-checkbox-input-checked {
  background-color: #28c58d !important;
  border-color: #28c58d !important;
}

.list-item {
  background: #fff;
  border-radius: 8rpx;
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
}

.list-item-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 16rpx;
}

.list-item-type {
  font-size: 32rpx;
  font-weight: 700;
  color: #3e3e59;
}

.list-item-time {
  color: #747d96;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.list-item-duration {
  color: #747d96;
  font-size: 26rpx;
  margin-top: 8rpx;
}

.list-item-apply-time {
  color: #969799;
  font-size: 24rpx;
  margin-top: 16rpx;
}

.green-bg {
  background: #eefbf7;
  color: #28c58d;
  border-radius: 8rpx;
  border: 1rpx solid #c0f1df;
  padding: 8rpx 16rpx;
  font-size: 24rpx;
}

.details-content {
  background: #f8f9fa;
  padding: 24rpx 32rpx;
  border-radius: 8rpx;
  line-height: 44rpx;
  color: #979eb1;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
}

.details-title {
  font-size: 32rpx;
  font-weight: 700;
  margin: 32rpx 0 20rpx;
  color: #3e3e59;
}

picker {
  width: 100%;
}

.handle-box {
  display: flex;
  border: 1rpx solid #eef1f7;
  border-radius: 8rpx;
  margin-top: 20rpx;
  overflow: hidden;
}

.handle-box .handle-btn {
  flex: 1;
  border: none;
  height: 80rpx;
  font-size: 32rpx;
  color: #bcc1cb;
  background: #fff;
  display: flex;
  align-items: center;
  justify-content: center;
}

.handle-box .handle-btn:last-child {
  color: #28c58d;
}

.alert-message {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.2);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.alert-message-content {
  background: #fff;
  border-radius: 8rpx;
  padding: 40rpx;
  width: 600rpx;
  text-align: center;
}

.alert-message-title {
  font-size: 36rpx;
  font-weight: 700;
  color: #3e3e59;
  margin-bottom: 20rpx;
}

.alert-message-text {
  font-size: 28rpx;
  color: #747d96;
  line-height: 44rpx;
  margin-bottom: 30rpx;
}

.role-dialog {
  position: fixed;
  top: 0;
  left: 0;
  width: 100%;
  height: 100%;
  background: rgba(0,0,0,0.2);
  z-index: 2000;
  display: flex;
  align-items: center;
  justify-content: center;
}

.role-dialog-content {
  background: #fff;
  border-radius: 8rpx;
  padding: 40rpx;
  width: 600rpx;
}

.role-dialog-title {
  font-size: 32rpx;
  font-weight: 700;
  color: #3e3e59;
  margin-bottom: 20rpx;
}

.role-dialog-item {
  background: #0e8cfe;
  margin: 10rpx 0;
  padding: 20rpx;
  color: #fff;
  border-radius: 8rpx;
  font-size: 28rpx;
}

.steps {
  font-size: 28rpx;
  padding-left: 35rpx;
  margin-top: 40rpx;
}

.steps .steps-content {
  width: 98%;
}

.steps .steps-content-item {
  border-left: 2rpx solid #ddd;
  padding: 0 0 40rpx 40rpx;
  position: relative;
}

.steps .steps-content-item:last-child {
  border-left: none;
}

.steps .steps-box-icon {
  min-width: 48rpx;
  max-width: 48rpx;
  height: 48rpx;
  text-align: center;
  line-height: 48rpx;
  position: absolute;
  left: -24rpx;
  top: -8rpx;
  background: #fff;
  border-radius: 50%;
}

.steps .steps-icon-active {
  min-width: 64rpx;
  max-width: 64rpx;
  margin-top: -8rpx;
  background: #28c58d;
  color: #fff;
}

.steps .steps-opinion {
  padding: 16rpx 24rpx;
  border-radius: 8rpx;
  margin-top: 16rpx;
  font-size: 24rpx;
  background: #f8f9fa;
}

.block-label .van-cell__value {
  background: #f8f9fa;
  border-radius: 8rpx;
  padding: 16rpx 32rpx;
  margin-top: 18rpx;
  border: 1rpx solid #eef1f7;
}

.no-data {
  text-align: center;
  padding: 80rpx 0;
}

.no-data image {
  width: 200rpx;
  height: 200rpx;
}

.leave-header {
  display: flex;
  justify-content: space-between;
  align-items: center;
  padding: 24rpx 32rpx;
  background-color: #fff;
  border-radius: 16rpx;
  margin: 20rpx;
  box-shadow: 0 2rpx 12rpx rgba(0,0,0,0.05);
}

.leave-type {
  background-color: #55D17D;
  color: white;
  font-size: 28rpx;
  padding: 8rpx 20rpx;
  border-radius: 40rpx 40rpx 0 40rpx;
  font-weight: 500;
}

.my-apply {
  color: #434053;
  font-size: 32rpx;
  font-weight: 700;
  margin-left: 20rpx;
}

.page-header {
  padding: 30rpx 20rpx 10rpx;
}

.page-title {
  font-size: 40rpx;
  font-weight: 700;
  color: #1f2a37;
}

.page-subtitle {
  margin-top: 10rpx;
  color: #9ea6b8;
  font-size: 24rpx;
}

.form-card,
.summary-card {
  margin: 0 20rpx 20rpx;
  padding: 30rpx;
  background: #fff;
  border-radius: 24rpx;
  box-shadow: 0 2rpx 20rpx rgba(0, 0, 0, 0.04);
}

.form-item {
  display: flex;
  align-items: center;
  padding: 20rpx 0;
  border-bottom: 1rpx solid #eef1f7;
}

.form-item:last-child {
  border-bottom: none;
}

.form-item.switch-row {
  justify-content: space-between;
}

.form-item .label {
  width: 240rpx;
  color: #6c7282;
  font-size: 28rpx;
}

.required {
  color: #f56664;
  margin-right: 8rpx;
}

.picker-value,
input,
textarea {
  flex: 1;
  color: #333;
  font-size: 28rpx;
}

textarea {
  min-height: 120rpx;
}

.attachment-list {
  display: flex;
  flex-wrap: wrap;
  gap: 16rpx;
}

.attachment-placeholder {
  width: 120rpx;
  height: 120rpx;
  border: 2rpx dashed #e6eaf4;
  border-radius: 16rpx;
  display: flex;
  align-items: center;
  justify-content: center;
  font-size: 48rpx;
  color: #c0c5d6;
}

.attachment-count {
  color: #9ea6b8;
  font-size: 24rpx;
  margin-top: 10rpx;
}

.forward-btn {
  width: 100%;
  margin-top: 20rpx;
  background: #06ced3;
  color: #fff;
  border-radius: 50rpx;
  height: 88rpx;
  font-size: 30rpx;
  border: none;
}

.summary-top {
  display: flex;
  justify-content: space-between;
  align-items: center;
  margin-bottom: 24rpx;
}

.approval-steps {
  position: relative;
  padding-left: 60rpx;
  margin-top: 20rpx;
}

.timeline-line {
  position: absolute;
  left: 20rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #e6f7f4;
}

.step {
  position: relative;
  padding: 24rpx 24rpx 24rpx 54rpx;
  margin-bottom: 20rpx;
  background: #fbfefe;
  border-radius: 20rpx;
}

.step:last-child {
  margin-bottom: 0;
}

.step-marker {
  position: absolute;
  left: 12rpx;
  top: 28rpx;
  width: 28rpx;
  height: 28rpx;
  border-radius: 50%;
  background: #06ced3;
  box-shadow: 0 0 0 8rpx rgba(6, 206, 211, 0.12);
}

.step-body {
  display: flex;
  flex-direction: column;
}

.step-name {
  font-size: 30rpx;
  color: #24324d;
  font-weight: 600;
}

.step-time {
  font-size: 24rpx;
  color: #8f9bb3;
  margin-top: 10rpx;
}

.step-opinion {
  margin-top: 12rpx;
  padding: 18rpx 20rpx;
  border-radius: 16rpx;
  background: #f0fff8;
  color: #4c8f73;
  font-size: 26rpx;
  line-height: 40rpx;
}

.summary-left {
  display: flex;
  align-items: center;
}

.status-stamp {
  padding: 10rpx 20rpx;
  border-radius: 40rpx;
  border: 1rpx solid #ffb67a;
  color: #ff8120;
  font-size: 24rpx;
  background: rgba(255, 139, 13, 0.08);
}

.summary-info {
  padding-top: 10rpx;
}

.summary-row {
  display: flex;
  flex-wrap: wrap;
  margin-bottom: 16rpx;
}

.summary-label {
  width: 220rpx;
  color: #B7B8BA;
}

.details-content {
  background: #f8f9fa;
  padding: 24rpx 32rpx;
  border-radius: 8rpx;
  line-height: 44rpx;
  color: #979eb1;
  margin-top: 16rpx;
  margin-bottom: 40rpx;
}

.info-container {
  background: #F8F9FB;
  border-radius: 16rpx;
  padding: 24rpx;
  font-size: 26rpx;
}

.info-container .summary-label {
  width: auto;
  margin-right: 8rpx;
  flex-shrink: 0;
}

.info-container .summary-row {
  margin-bottom: -6rpx;
}

.info-container .double-row {
  margin-bottom: 20rpx;
}

.info-container .detail-time {
  margin-bottom: 10rpx;
}

.current-approver {
  margin-top: 20rpx;
  color: #28c58d;
  font-size: 26rpx;
  padding: 18rpx 24rpx;
  background: #eefbf7;
  border-radius: 14rpx;
  border: 1rpx solid #c0f1df;
}

.info-container .double-row .summary-field:last-child {
  margin-left: -60rpx;
}

.summary-field {
  flex: 1;
  display: flex;
  flex-wrap: wrap;
  align-items: center;
}

.summary-field text {
  font-size: 28rpx;
  color: #3c4451;
}

.detail-rule,
.detail-time,
.detail-line,
.approval-flow {
  display: flex;
  align-items: flex-start;
  padding: 18rpx 0;
}

.detail-rule {
  min-height: 70rpx;
}

.detail-time {
  padding-bottom: 18rpx;
}

.detail-line {
  padding-bottom: 18rpx;
}

.approval-flow {
  align-items: center;
}

.summary-label {
  width: 180rpx;
  color: #98a4b7;
  font-size: 26rpx;
}

.view-more {
  color: #06ced3;
  font-size: 26rpx;
  margin-left: 10rpx;
}

.reason-block {
  margin-top: 20rpx;
}

.reason-label {
  color: #98a4b7;
  font-size: 26rpx;
}

.promise-box {
  margin-top: 20rpx;
  display: flex;
  align-items: flex-start;
  background: #fff7ef;
  border: 1rpx solid #ffe6d4;
  border-radius: 18rpx;
  padding: 24rpx;
}

.promise-icon {
  width: 44rpx;
  height: 44rpx;
  border-radius: 50%;
  background: #ffe2c7;
  margin-right: 20rpx;
}

.promise-text {
  color: #8e9bb2;
  font-size: 26rpx;
  line-height: 38rpx;
  flex: 1;
}

.flow-card .section-title {
  margin-bottom: 20rpx;
}

.approval-steps {
  position: relative;
  padding-left: 54rpx;
}

.timeline-line {
  position: absolute;
  left: 25rpx;
  top: 0;
  bottom: 0;
  width: 2rpx;
  background: #e5f9f7;
}

.step {
  position: relative;
  padding: 28rpx 24rpx 28rpx 36rpx;
  margin-bottom: 22rpx;
  background: #fbfefe;
  border-radius: 24rpx;
}

.step-marker {
  position: absolute;
  left: 12rpx;
  top: 30rpx;
  width: 30rpx;
  height: 30rpx;
  border-radius: 50%;
  background: #06ced3;
  box-shadow: 0 0 0 8rpx rgba(6, 206, 211, 0.12);
}

.step-body {
  display: flex;
  flex-direction: column;
}

.step-name {
  color: #24324d;
  font-size: 30rpx;
  font-weight: 600;
}

.step-time {
  margin-top: 14rpx;
  font-size: 24rpx;
  color: #8f9bb3;
}

.step-opinion {
  margin-top: 14rpx;
  padding: 18rpx 22rpx;
  border-radius: 18rpx;
  background: #f0fffa;
  color: #3d8f77;
  font-size: 26rpx;
  line-height: 40rpx;
}

